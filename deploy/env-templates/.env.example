# UROS — Cloud/Standard deployment environment template.
# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
DATABASE_URL=postgres://uros:uros@localhost:5432/uros
REDIS_URL=redis://localhost:6379
DEPLOYMENT_MODE=CLOUD
PORT=3000

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-32-plus-character-secret

# AES-256-GCM key for encrypting BYOK connector credentials at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

LOG_LEVEL=info
DEFAULT_OCR_CONFIDENCE_THRESHOLD=0.85
GATE_TIMEOUT_MS=2592000000
WEBHOOK_SCHEDULER_INTERVAL_MS=30000

# --- Phase 7: Deploy & Ops ---
# Comma-separated browser origins allowed to call the API. Leave unset in
# local dev (reflects any origin); ALWAYS set explicitly in production.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Set true only when running behind a trusted reverse proxy / load
# balancer / ingress that sets X-Forwarded-For.
TRUST_PROXY=true

# Optional shared secret to gate /metrics. Leave unset if Prometheus
# scraping happens over a private network already restricted at the
# firewall/security-group level.
METRICS_TOKEN=

# Root path for original candidate/employee documents (used by
# scripts/backup.sh for document sync alongside the DB dump).
DOCUMENT_STORAGE_PATH=/data/uros/documents

# --- Feature 5: Multi-Language Interface and Document Support ---
# Local directory containing Tesseract .traineddata files (eng.traineddata,
# ben.traineddata) for OCR. Leave unset to let tesseract.js download from
# its default CDN (fine for cloud deployments with outbound internet).
# REQUIRED for on-premises/air-gapped deployments — set this to a
# directory pre-populated with the traineddata files so Bangla (and
# English) OCR never depends on outbound network access.
TESSERACT_LANG_PATH=

# --- Backup & DR (consumed by scripts/backup.sh / restore.sh, not the app) ---
# Symmetric passphrase used to encrypt backup archives at rest.
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_PASSPHRASE=replace-this-with-a-strong-passphrase
BACKUP_OUTPUT_DIR=./backups
# Optional: retention in days for local backup pruning by backup.sh
BACKUP_RETENTION_DAYS=30

# --- Agent-Level Hardening (src/services/agent_runner) ---
# Every agent invocation runs through the generic runner: a per-call
# timeout, bounded retry with exponential backoff for *transient* failures
# only, and a per-agent circuit breaker. All values are validated at
# startup (src/config/env.schema.ts); the process refuses to boot on an
# invalid setting rather than silently falling back.

# Per-invocation deadline. Agents that legitimately run longer (OCR,
# large batch scoring) carry their own override in
# src/services/agent_runner/agents.ts.
AGENT_TIMEOUT_MS=30000
# Retries after the first attempt, for transient failures only. 0 disables
# retry; a genuine logic error is never retried regardless of this value.
AGENT_MAX_RETRIES=2
# Exponential backoff: base * 2^attempt, capped at AGENT_BACKOFF_MAX_MS.
AGENT_BACKOFF_BASE_MS=200
AGENT_BACKOFF_MAX_MS=5000
# Consecutive failures before an agent's circuit opens, and how long it
# stays open before a single half-open probe is admitted.
AGENT_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_CIRCUIT_RESET_MS=30000
# Write one audit_log row per runner event (start/success/failure/retry/
# circuit change). UROS audits everything, so this defaults to true; turn
# it off only where audit volume is a measured problem.
AGENT_AUDIT_ENABLED=true

# Worker pool sizes, one per agent class. Queue-based, so a slow agent can
# never occupy the API request path. The defaults sum to exactly DB_POOL_MAX
# (20): every in-flight pooled task ultimately holds a database connection,
# and startup logs a warning if you raise the total past it.
AGENT_POOL_INTAKE_SIZE=4
AGENT_POOL_PARSER_SIZE=2
AGENT_POOL_SCANNER_SIZE=2
AGENT_POOL_SCORING_SIZE=4
AGENT_POOL_VERIFICATION_SIZE=2
AGENT_POOL_COMMUNICATION_SIZE=2
AGENT_POOL_ANALYTICS_SIZE=2
AGENT_POOL_GENERAL_SIZE=2
# Backpressure: submissions beyond this depth are rejected with
# AGENT_POOL_SATURATED rather than queued without bound.
AGENT_POOL_MAX_QUEUE_DEPTH=1000

# Durable batch progress (table agent_batch_progress, migration 0028).
# Persist a checkpoint every N items; 1 is the safest and cheap enough for
# candidate-sized batches. A batch whose owner stops heartbeating for
# AGENT_BATCH_STALE_AFTER_MS is reclaimed as INTERRUPTED on the next boot
# and resumes from its last checkpoint.
AGENT_CHECKPOINT_EVERY=1
AGENT_BATCH_STALE_AFTER_MS=120000

# In-app supervisor: bounded restarts with exponential backoff for
# long-lived loops (poll worker, schedulers). Once the budget is exhausted
# the process exits non-zero and the container restart policy takes over —
# a loud exit beats a silent crash loop.
AGENT_SUPERVISOR_MAX_RESTARTS=5
AGENT_SUPERVISOR_RESTART_BACKOFF_MS=1000
