# UROS — On-Premises / air-gapped deployment environment template.
# Copy to .env and fill in real values. Never commit the real .env file.
# Designed for government/bank data-sovereignty deployments (file 03 §4,
# file 20 §2): all services below run inside the organisation's own
# network via docker-compose.onprem.yml — no external cloud dependency.

NODE_ENV=production
DATABASE_URL=postgres://uros:CHANGE_ME@postgres:5432/uros
# Redis is bundled in docker-compose.onprem.yml for the evaluation queue
# and rate-limit backing; still fully within the on-prem network.
REDIS_URL=redis://redis:6379
DEPLOYMENT_MODE=ON_PREM
PORT=3000

# Generate with: openssl rand -hex 32 — rotate per your org's key policy.
JWT_SECRET=replace-this-with-a-32-plus-character-secret

# AES-256-GCM key for encrypting BYOK connector credentials at rest.
# Generate with: openssl rand -hex 32. Store the value itself in your
# organisation's own secrets manager / HSM, not in this file long-term.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

LOG_LEVEL=info
DEFAULT_OCR_CONFIDENCE_THRESHOLD=0.85
GATE_TIMEOUT_MS=2592000000
WEBHOOK_SCHEDULER_INTERVAL_MS=30000

# --- Phase 7: Deploy & Ops ---
# On-prem deployments typically serve one internal dashboard origin.
CORS_ALLOWED_ORIGINS=https://uros.internal.local

# UROS sits behind the organisation's own reverse proxy / ingress in
# on-prem topology.
TRUST_PROXY=true

# Recommended ON for on-prem: restrict /metrics to the internal
# monitoring stack even though the network itself is already air-gapped
# (defense-in-depth per file 03 §4 compliance requirements).
METRICS_TOKEN=replace-with-a-shared-secret-for-prometheus-scrape

# Document store should be a mounted volume on organisation-controlled
# storage (see docker-compose.onprem.yml `documents` volume).
DOCUMENT_STORAGE_PATH=/data/uros/documents

# Feature 5 (Multi-Language): air-gapped OCR requires local traineddata —
# pre-populate this directory with eng.traineddata and ben.traineddata
# (do NOT leave unset here; tesseract.js's default CDN fetch will fail
# with no outbound network).
TESSERACT_LANG_PATH=/data/uros/tessdata

# --- Backup & DR ---
# Generate with: openssl rand -base64 32. Store offline / in org HSM per
# file 20 §2.3 DR policy; losing this makes existing backups unusable.
BACKUP_ENCRYPTION_PASSPHRASE=replace-this-with-a-strong-passphrase
BACKUP_OUTPUT_DIR=/data/uros/backups
BACKUP_RETENTION_DAYS=90

# --- Agent-Level Hardening (src/services/agent_runner) ---
# Full descriptions in .env.example. On-premises boxes are usually sized
# conservatively, so these are the same safe defaults the application uses
# when the variables are absent — declared explicitly here so an air-gapped
# operator can tune them without reading source.
#
# Per-invocation deadline, transient-only retries, and exponential backoff.
AGENT_TIMEOUT_MS=30000
AGENT_MAX_RETRIES=2
AGENT_BACKOFF_BASE_MS=200
AGENT_BACKOFF_MAX_MS=5000
# Circuit breaker: opens after N consecutive failures, admits one probe
# after the reset window, closes again on a successful probe.
AGENT_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_CIRCUIT_RESET_MS=30000
# Audit every runner event. Keep true: on-prem deployments are the ones
# most often subject to audit obligations.
AGENT_AUDIT_ENABLED=true
# Worker pools per agent class. Total (20) is deliberately equal to
# DB_POOL_MAX so agents never queue on connection acquisition.
AGENT_POOL_INTAKE_SIZE=4
AGENT_POOL_PARSER_SIZE=2
AGENT_POOL_SCANNER_SIZE=2
AGENT_POOL_SCORING_SIZE=4
AGENT_POOL_VERIFICATION_SIZE=2
AGENT_POOL_COMMUNICATION_SIZE=2
AGENT_POOL_ANALYTICS_SIZE=2
AGENT_POOL_GENERAL_SIZE=2
AGENT_POOL_MAX_QUEUE_DEPTH=1000
# Crash recovery: checkpoint every item, reclaim a batch whose owner
# stopped heartbeating 2 minutes ago.
AGENT_CHECKPOINT_EVERY=1
AGENT_BATCH_STALE_AFTER_MS=120000
# In-app supervisor restart budget before the process exits non-zero and
# `restart: always` in docker-compose.onprem.yml brings it back.
AGENT_SUPERVISOR_MAX_RESTARTS=5
AGENT_SUPERVISOR_RESTART_BACKOFF_MS=1000
