# syntax=docker/dockerfile:1
#
# UROS Dashboard UI image — multi-stage build.
# Static Vite/React build served by an unprivileged nginx, which also
# reverse-proxies /api, /health, and /metrics to the API service so the
# browser talks same-origin (no CORS_ALLOWED_ORIGINS entry needed for the
# dashboard itself — only for any external integrators calling the API
# directly). API upstream host:port is injected at container start via
# nginx's built-in envsubst-on-templates support (no custom entrypoint
# script needed) — see UROS_API_UPSTREAM below.

########################################
# Stage 1: build static assets
########################################
FROM node:20-alpine AS build
WORKDIR /app/src/ui
COPY src/ui/package.json src/ui/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY src/ui ./
# VITE_API_ORIGIN is intentionally left empty at build time: the built
# app calls relative paths (e.g. `/api/v1/...`, `/health`), which nginx
# below proxies to the API — no origin needs to be baked into the bundle,
# so the same built image works unmodified in cloud or on-prem.
ENV VITE_API_ORIGIN=""
RUN npm run build

########################################
# Stage 2: minimal runtime image (non-root nginx)
########################################
FROM nginxinc/nginx-unprivileged:1.25-alpine AS runtime

COPY --from=build /app/src/ui/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template

# Default upstream matches the `api` service name in docker-compose.yml /
# docker-compose.onprem.yml; override via environment if the API service
# is named or hosted differently.
ENV UROS_API_UPSTREAM="api:3000"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1

# nginx-unprivileged's own entrypoint already runs envsubst on
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf and then
# `nginx -g daemon off;` — no CMD override needed.
