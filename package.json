{
  "name": "uros",
  "version": "0.1.0",
  "description": "Universal Recruitment Operations System — deterministic, configurable, human-in-the-loop recruitment platform",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:copy-assets",
    "build:copy-assets": "mkdir -p dist/database/migrations && cp src/database/migrations/*.sql dist/database/migrations/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/api/server.js",
    "dev": "ts-node src/api/server.ts",
    "worker": "ts-node src/services/queue/consumer.ts",
    "migrate": "ts-node src/database/migrate.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "lint": "eslint 'src/**/*.ts' --ignore-pattern 'src/ui/**'",
    "seed": "ts-node scripts/seed.ts",
    "webhook-scheduler": "ts-node src/services/webhooks/scheduler.ts",
    "hr-ops-scheduler": "ts-node src/services/hr_ops/scheduler.ts",
    "smoke-test": "bash scripts/smoke_test.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "dr-drill": "bash scripts/dr_drill.sh",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "imapflow": "^2.1.2",
    "ioredis": "^5.4.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3",
    "tesseract.js": "^5.1.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.9",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "smtp-server": "^3.19.15",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
